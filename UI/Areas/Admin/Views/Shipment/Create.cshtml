@model UI.Areas.Admin.Models.ShipmentWizardViewModel
@{
    ViewBag.Title = "Create Shipment";
}

<div class="container-fluid py-4" style="max-width: 1000px;">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h4 class="fw-bold mb-1">Shipment Wizard</h4>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">New Logistical Record</span>
                <span class="small fw-bold" style="color: var(--bs-primary);">&bull; Step 1 of 3</span>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">CREATING AS OPERATOR</span>
            </div>
        </div>
        <div>
            <div class="btn-group shadow-sm bg-white p-1 rounded-pill" role="group">
                <span class="px-3 py-1 text-muted small fw-bold d-flex align-items-center">PREVIEW ROLE</span>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Admin</button>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Manager</button>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3">Operator</button>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Reviewer</button>
            </div>
        </div>
    </div>

    <div class="sf-wizard-steps d-flex justify-content-center align-items-center mb-5 mt-4 position-relative">
        <div class="d-flex flex-column align-items-center position-relative z-index-1" style="width: 120px;">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white mb-2" style="width: 48px; height: 48px; background-color: var(--bs-primary); box-shadow: 0 0 0 4px rgba(94,92,230,0.2);">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="small fw-bold text-center" style="color: var(--bs-primary); font-size: 0.75rem;">SENDER INFORMATION</div>
        </div>
        
        <div class="flex-grow-1 mx-2 bg-secondary bg-opacity-25" style="height: 2px; max-width: 100px; margin-top: -20px;"></div>
        
        <div class="d-flex flex-column align-items-center position-relative z-index-1" style="width: 120px;">
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-muted mb-2 border" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="small fw-bold text-muted text-center" style="font-size: 0.75rem;">RECEIVER INFORMATION</div>
        </div>
        
        <div class="flex-grow-1 mx-2 bg-secondary bg-opacity-25" style="height: 2px; max-width: 100px; margin-top: -20px;"></div>
        
        <div class="d-flex flex-column align-items-center position-relative z-index-1" style="width: 120px;">
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-muted mb-2 border" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-box"></i>
            </div>
            <div class="small fw-bold text-muted text-center" style="font-size: 0.75rem;">SHIPMENT DETAILS</div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="mb-4">
            <h5 class="fw-bold mb-1"><i class="fa-solid fa-user me-2" style="color: var(--bs-primary);"></i> Sender Information</h5>
            <div class="text-muted small ms-4 ps-1">Origin details</div>
        </div>

        <form asp-action="Create" asp-controller="Shipment" asp-area="Admin" method="post">
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold small">Full Name / Company <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-light text-muted"><i class="fa-regular fa-user"></i></span>
                        <input asp-for="FullName" class="form-control bg-light border-light" placeholder="Enter name">
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold small">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control bg-light border-light" placeholder="name@example.com">
                </div>
                
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-bold small">Phone Number <span class="text-danger">*</span></label>
                    <input asp-for="PhoneNumber" class="form-control bg-light border-light" placeholder="+1 (555) 000-0000">
                </div>
                <div class="col-md-6">
                    <label asp-for="City" class="form-label fw-bold small">City <span class="text-danger">*</span></label>
                    <input asp-for="City" class="form-control bg-light border-light" placeholder="Enter city">
                </div>
                
                <div class="col-12">
                    <label asp-for="FullAddress" class="form-label fw-bold small">Full Address <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-light text-muted"><i class="fa-solid fa-location-dot"></i></span>
                        <input asp-for="FullAddress" class="form-control bg-light border-light" placeholder="Street name, building, apartment...">
                    </div>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="PostalCode" class="form-label fw-bold small">Postal Code <span class="text-danger">*</span></label>
                    <input asp-for="PostalCode" class="form-control bg-light border-light" placeholder="00000">
                </div>
                <div class="col-md-6">
                    <label asp-for="PointOfContact" class="form-label fw-bold small">Point of Contact</label>
                    <input asp-for="PointOfContact" class="form-control bg-light border-light" placeholder="Name of person in charge">
                </div>
                
                <div class="col-12">
                    <label asp-for="OtherAddressDetails" class="form-label fw-bold small">Other Address Details</label>
                    <input asp-for="OtherAddressDetails" class="form-control bg-light border-light" placeholder="Floor, suite, landmarks...">
                </div>
                
                <div class="col-12 mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsDefaultSender">
                        <label class="form-check-label text-muted" asp-for="IsDefaultSender">
                            Set as default sender address
                        </label>
                    </div>
                </div>
            </div>

            <hr class="text-muted opacity-25 mb-4">

            <div class="d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-light text-muted px-4" disabled>&lt; Previous Step</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sf-outline-danger btn-outline-danger px-4">Cancel Draft</button>
                    <button type="submit" class="btn btn-sf-primary text-white px-4" style="background-color: var(--bs-primary); border-color: var(--bs-primary);">Next Step &gt;</button>
                </div>
            </div>
        </form>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 bg-white p-3 rounded-4 shadow-sm h-100">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-success flex-shrink-0" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-floppy-disk"></i>
                </div>
                <div>
                    <div class="fw-bold small mb-1">Save as Draft</div>
                    <div class="text-muted" style="font-size: 0.8rem;">Your progress is automatically saved to your drafts folder.</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 bg-white p-3 rounded-4 shadow-sm h-100">
                <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-warning flex-shrink-0" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <div class="fw-bold small mb-1">Real-time Rates</div>
                    <div class="text-muted" style="font-size: 0.8rem;">Rate estimates are fetched from global carrier APIs.</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 bg-white p-3 rounded-4 shadow-sm h-100">
                <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-danger flex-shrink-0" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <div class="fw-bold small mb-1">Review Requirements</div>
                    <div class="text-muted" style="font-size: 0.8rem;">Certain roles require second-level supervisor approval.</div>
                </div>
            </div>
        </div>
    </div>
</div>
