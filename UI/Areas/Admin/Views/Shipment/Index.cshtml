@model UI.Areas.Admin.Models.ShipmentIndexViewModel
@{
    ViewBag.Title = "Shipments";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h4 class="fw-bold mb-1">Shipment Management</h4>
            <div class="text-muted">Monitor and control global logistics operations.</div>
        </div>
        <div>
            <div class="btn-group shadow-sm bg-white p-1 rounded-pill" role="group">
                <span class="px-3 py-1 text-muted small fw-bold d-flex align-items-center">PREVIEW ROLE</span>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3">Admin</button>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Manager</button>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Operator</button>
                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-pill px-3">Reviewer</button>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary"><i class="fa-solid fa-download me-1"></i> Export Report</button>
            <a asp-action="Create" asp-controller="Shipment" asp-area="Admin" class="btn btn-sf-primary text-white" style="background-color: var(--bs-primary); border-color: var(--bs-primary);"><i class="fa-solid fa-plus me-1"></i> Create New Shipment</a>
        </div>
    </div>

    <div class="sf-hero-card card border-0 p-5 mb-4 position-relative overflow-hidden" style="border-radius: 16px; background: linear-gradient(135deg, rgba(94,92,230,0.85), rgba(94,92,230,0.4));">
        <div class="row position-relative z-index-1">
            <div class="col-lg-6">
                <h4 class="text-white fw-bold mb-3">Efficient Supply Chain Oversight</h4>
                <p class="text-white-50 mb-0">Manage your entire logistics network from a single unified interface. Track shipments in real-time, handle exceptions, and optimize delivery routes with advanced analytics.</p>
            </div>
        </div>
        <div class="position-absolute end-0 bottom-0 top-0 w-50 opacity-25" style="background: radial-gradient(circle at right center, rgba(255,255,255,0.2) 0%, transparent 70%);"></div>
    </div>

    <div class="sf-filter-bar card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold mb-1">Status</label>
                <select class="form-select bg-light border-light">
                    <option>All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold mb-1">Date Range</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-light text-muted"><i class="fa-regular fa-calendar"></i></span>
                    <input type="text" class="form-control bg-light border-light" placeholder="Select dates...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold mb-1">Sender</label>
                <input type="text" class="form-control bg-light border-light" placeholder="Filter by sender...">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold mb-1">Receiver</label>
                <input type="text" class="form-control bg-light border-light" placeholder="Filter by receiver...">
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4 bg-white">
        <div class="card-header bg-white border-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0"><i class="fa-solid fa-ship me-2 text-muted"></i> Shipment Records</h6>
            <div class="d-flex align-items-center gap-3">
                <a href="#" class="text-decoration-none small" style="color: var(--bs-primary);">Advanced filters</a>
                <span class="text-muted small">Sort: <span class="fw-bold text-dark">Newest First</span></span>
            </div>
        </div>
        <div class="card-body px-0 pb-0">
            <div class="table-responsive">
                <table class="table sf-table table-hover align-middle mb-0">
                    <thead class="text-muted small bg-light bg-opacity-50">
                        <tr>
                            <th class="ps-4">TRACKING #</th>
                            <th>SENDER</th>
                            <th>RECEIVER</th>
                            <th>SHIPPING DATE</th>
                            <th>STATUS</th>
                            <th class="text-end pe-4">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Shipments != null)
                        {
                            foreach (var item in Model.Shipments)
                            {
                                <tr>
                                    <td class="ps-4"><a href="#" class="sf-tracking-link text-decoration-none fw-bold text-dark">@item.TrackingNumber</a></td>
                                    <td>
                                        <div class="fw-bold">@item.SenderName</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.ReceiverName</div>
                                    </td>
                                    <td>
                                        <div class="text-muted small"><i class="fa-regular fa-calendar me-1"></i>@item.ShippingDate</div>
                                    </td>
                                    <td>@await Html.PartialAsync("_StatusBadge", item.Status)</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button class="btn btn-sm btn-light rounded-circle sf-action-btn"><i class="fa-regular fa-eye"></i></button>
                                            <button class="btn btn-sm btn-light rounded-circle sf-action-btn"><i class="fa-solid fa-pencil"></i></button>
                                            <button class="btn btn-sm btn-light rounded-circle sf-action-btn text-danger"><i class="fa-solid fa-trash"></i></button>
                                            <button class="btn btn-sm btn-light border-0 rounded-circle ms-1"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 px-4">
            @if (Model.Pagination != null)
            {
                @await Html.PartialAsync("_Pagination", Model.Pagination)
            }
        </div>
    </div>
</div>
