    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@using UI.Helpers
@model BL.DTOs.Views.ShipmentDetailsDto
@{
    ViewBag.Title = "Shipment Details";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Back to shipments</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">
            <i class="fa-solid fa-ship me-2 text-primary"></i>
            Shipment Details
        </h4>
        <span class="badge bg-light text-dark px-3 py-2">Tracking: @Model.TrackingNumber</span>
    </div>

    <div class="card-body p-4">
        <!-- Status & Timeline -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                    <span class="fw-bold">Status:</span>
                    @await Html.PartialAsync("_StatusBadge", Model.Status)
                    <span class="text-muted small">
                        <i class="fa-regular fa-clock me-1"></i>
                        Last updated: @(Model.StatusLastUpdatedAt?.ToString("dd MMM yyyy HH:mm") ?? "N/A")
                    </span>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <div class="d-flex justify-content-end gap-2">
                    <!-- View All Shipments -->
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-list me-1"></i> All Shipments
                    </a>
                </div>
            </div>
        </div>

        <!-- Sender & Receiver -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user me-2"></i> Sender</h6>
                        <p class="mb-1"><strong>Name:</strong> @Model.SenderName</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.SenderEmail</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.SenderPhone</p>
                        <p class="mb-1"><strong>Address:</strong> @Model.SenderAddress</p>
                        <p class="mb-1"><strong>City:</strong> @Model.SenderCityName</p>
                        <p class="mb-1"><strong>Country:</strong> @Model.SenderCountryName</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-user me-2"></i> Receiver</h6>
                        <p class="mb-1"><strong>Name:</strong> @Model.ReceiverName</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.ReceiverEmail</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.ReceiverPhone</p>
                        <p class="mb-1"><strong>Address:</strong> @Model.ReceiverAddress</p>
                        <p class="mb-1"><strong>City:</strong> @Model.ReceiverCityName</p>
                        <p class="mb-1"><strong>Country:</strong> @Model.ReceiverCountryName</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Package Details -->
        <div class="card bg-light border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-box me-2"></i> Package Information</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Weight</span>
                        <span class="fw-bold">@Model.Weight.ToString("F2") kg</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Dimensions</span>
                        <span class="fw-bold">@Model.Width × @Model.Height × @Model.Length cm</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Declared Value</span>
                        <span class="fw-bold">$@Model.PackageValue.ToString("F2")</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Shipping Rate</span>
                        <span class="fw-bold">$@Model.ShippingRate.ToString("F2")</span>
                    </div>
                </div>
                <hr class="my-3">
                <div class="row g-3">
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Shipping Date</span>
                        <span class="fw-bold">@Model.ShippingDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Delivery Date</span>
                        <span class="fw-bold">@(Model.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Shipping Type</span>
                        <span class="fw-bold">@Model.ShippingTypeName</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small d-block">Payment Method</span>
                        <span class="fw-bold">@Model.PaymentMethodEName</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline (optional: you can show history from TbShipmentStatusHistory if available) -->
        @* You can add a timeline here if you have the history list *@

        <!-- Action Buttons – Based on role and status -->
        <div class="d-flex justify-content-end gap-2 mt-4">
            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Op))
            {
                <a asp-action="Edit" asp-route-id="@Model.ShipmentId" class="btn btn-outline-primary">
                    <i class="fa-solid fa-pen me-1"></i> Edit
                </a>
            }

            @if ((Model.Status == enShipmentStatus.Created || Model.Status == enShipmentStatus.Returned) &&
                (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.OpManager) || User.IsInRole(AppRoles.Reviewer)))
            {
                <form asp-action="Approve" asp-route-id="@Model.ShipmentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-check me-1"></i> Approve
                    </button>
                </form>
            }

            @if ((Model.Status == enShipmentStatus.Approved || Model.Status == enShipmentStatus.Created) &&
                (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.OpManager) || User.IsInRole(AppRoles.Op)))
            {
                <form asp-action="MarkReadyForShip" asp-route-id="@Model.ShipmentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="fa-solid fa-box-open me-1"></i> Mark Ready
                    </button>
                </form>
            }

            @if ((Model.Status == enShipmentStatus.ReadyForShip || Model.Status == enShipmentStatus.Approved) &&
                (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.OpManager)))
            {
                <form asp-action="MarkShipped" asp-route-id="@Model.ShipmentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <select name="carrierId" class="form-select form-select-sm" style="min-width: 150px;">
                            <option value="">Select Carrier</option>
                            @if (ViewBag.Carriers != null)
                            {
                                foreach (var carrier in ViewBag.Carriers as List<SelectListItem>)
                                {
                                    <option value="@carrier.Value">@carrier.Text</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-info text-white">
                            <i class="fa-solid fa-truck-fast me-1"></i> Ship
                        </button>
                    </div>
                </form>
            }

            @if (User.IsInRole(AppRoles.Admin))
            {
                <form asp-action="Delete" asp-route-id="@Model.ShipmentId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this shipment?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                    </button>
                </form>
            }
        </div>
    </div>
</div>