@using UI.Areas.Admin.Models
@model CountryFormViewModel
@{ ViewBag.Title = "Add New Country"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> back to countries</a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3 border-bottom">
        <h4 class="mb-0"><i class="fa-solid fa-globe" style="color: #5e5ce6"></i> Add New Country</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="CountryEname" class="form-label">English Name *</label>
                <input asp-for="CountryEname" class="form-control" />
                <span asp-validation-for="CountryEname" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="CountryAname" class="form-label">Arabic Name *</label>
                <input asp-for="CountryAname" class="form-control" />
                <span asp-validation-for="CountryAname" class="text-danger"></span>
            </div>
            
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            
            <div class="d-grid">
                <button type="submit" class="btn btn-sf-primary btn-lg">Save Country</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
