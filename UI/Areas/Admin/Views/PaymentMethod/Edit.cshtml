@using UI.Areas.Admin.Models
@model PaymentMethodFormViewModel
@{ ViewBag.Title = "Edit Payment Method"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> back to payment methods</a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3 border-bottom">
        <h4 class="mb-0"><i class="fa-solid fa-credit-card" style="color: #5e5ce6"></i> Edit Payment Method</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="EnglishName" class="form-label">English Name *</label>
                <input asp-for="EnglishName" class="form-control" />
                <span asp-validation-for="EnglishName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ArabicName" class="form-label">Arabic Name *</label>
                <input asp-for="ArabicName" class="form-control" />
                <span asp-validation-for="ArabicName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Commission" class="form-label">Commission % *</label>
                <input asp-for="Commission" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Commission" class="text-danger"></span>
            </div>
            
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            
            <div class="d-grid">
                <button type="submit" class="btn btn-sf-primary btn-lg">Update Payment Method</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
