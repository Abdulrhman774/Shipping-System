@model UI.Areas.Admin.Models.AdminProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<!-- Profile Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">My Profile</h4>
        <p class="text-muted mb-0">Manage your account settings and preferences</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left: Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <!-- Cover -->
            <div style="height: 100px; background: linear-gradient(135deg, #5e5ce6 0%, #7b68ee 50%, #9b59b6 100%);"></div>
            <!-- Avatar & Info -->
            <div class="card-body text-center" style="margin-top: -50px;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white fw-bold"
                     style="width: 90px; height: 90px; font-size: 1.75rem; background: linear-gradient(135deg, #5e5ce6, #7b68ee); border: 4px solid white; box-shadow: 0 4px 15px rgba(94,92,230,.3);">
                    @Model.AvatarInitials
                </div>
                <h5 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h5>
                <span class="badge rounded-pill px-3 py-1 mb-3" style="background-color: rgba(94,92,230,.1); color: #5e5ce6; font-size: 0.8rem;">
                    <i class="fa-solid fa-shield-halved me-1"></i> @Model.Role
                </span>
                <hr class="my-3">
                <div class="text-start px-2">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; min-width: 36px;">
                            <i class="fa-regular fa-envelope text-muted"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">Email</div>
                            <div class="small fw-semibold">@Model.Email</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; min-width: 36px;">
                            <i class="fa-solid fa-phone text-muted"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">Phone</div>
                            <div class="small fw-semibold">@Model.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; min-width: 36px;">
                            <i class="fa-solid fa-building text-muted"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">Department</div>
                            <div class="small fw-semibold">@Model.Department</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; min-width: 36px;">
                            <i class="fa-regular fa-calendar text-muted"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">Member Since</div>
                            <div class="small fw-semibold">@Model.JoinDate</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Tabs -->
    <div class="col-lg-8">
        <!-- Nav Tabs -->
        <ul class="nav nav-pills mb-4 gap-2" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4" id="personal-tab" data-bs-toggle="tab"
                        data-bs-target="#personal" type="button" role="tab"
                        style="font-size: 0.875rem; font-weight: 600;">
                    <i class="fa-regular fa-user me-2"></i>Personal Info
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4" id="security-tab" data-bs-toggle="tab"
                        data-bs-target="#security" type="button" role="tab"
                        style="font-size: 0.875rem; font-weight: 600;">
                    <i class="fa-solid fa-lock me-2"></i>Security
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
            <!-- TAB 1: Personal Info -->
            <div class="tab-pane fade show active" id="personal" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                        <h6 class="mb-0 fw-bold"><i class="fa-regular fa-id-card me-2" style="color: #5e5ce6;"></i>Personal Information</h6>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Account" asp-action="Profile" method="post">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label small fw-semibold text-muted">First Name <span class="text-danger">*</span></label>
                                    <input asp-for="FirstName" class="form-control rounded-3" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label small fw-semibold text-muted">Last Name <span class="text-danger">*</span></label>
                                    <input asp-for="LastName" class="form-control rounded-3" />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label small fw-semibold text-muted">Email Address <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-regular fa-envelope text-muted"></i></span>
                                        <input asp-for="Email" type="email" class="form-control border-start-0 rounded-end-3" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label small fw-semibold text-muted">Phone Number <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-phone text-muted"></i></span>
                                        <input asp-for="PhoneNumber" type="tel" class="form-control border-start-0 rounded-end-3" />
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Department" class="form-label small fw-semibold text-muted">Department</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-building text-muted"></i></span>
                                        <input asp-for="Department" class="form-control border-start-0 rounded-end-3" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TimeZone" class="form-label small fw-semibold text-muted">Time Zone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-regular fa-clock text-muted"></i></span>
                                        <input asp-for="TimeZone" class="form-control border-start-0 rounded-end-3" />
                                    </div>
                                </div>
                            </div>
                            <hr class="my-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                                <button type="submit" class="btn rounded-pill px-4 text-white" style="background: linear-gradient(135deg, #5e5ce6, #7b68ee);">
                                    <i class="fa-solid fa-check me-2"></i>Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- TAB 2: Security -->
            <div class="tab-pane fade" id="security" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-shield-halved me-2" style="color: #5e5ce6;"></i>Change Password</h6>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Account" asp-action="ChangePassword" method="post">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Current Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-lock text-muted"></i></span>
                                    <input type="password" name="CurrentPassword" class="form-control border-start-0 rounded-end-3" placeholder="Enter current password" />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-muted">New Password <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-key text-muted"></i></span>
                                        <input type="password" name="NewPassword" class="form-control border-start-0 rounded-end-3" placeholder="Enter new password" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-muted">Confirm New Password <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="fa-solid fa-key text-muted"></i></span>
                                        <input type="password" name="ConfirmPassword" class="form-control border-start-0 rounded-end-3" placeholder="Confirm new password" />
                                    </div>
                                </div>
                            </div>

                            <!-- Password Requirements -->
                            <div class="alert border-0 rounded-3 mb-4" style="background-color: #f0f0ff;">
                                <h6 class="fw-bold small mb-2" style="color: #5e5ce6;"><i class="fa-solid fa-info-circle me-1"></i> Password Requirements</h6>
                                <ul class="mb-0 ps-3 small text-muted">
                                    <li>Minimum 8 characters long</li>
                                    <li>At least one uppercase letter</li>
                                    <li>At least one number</li>
                                    <li>At least one special character (@@, #, $, etc.)</li>
                                </ul>
                            </div>

                            <hr class="my-4">
                            <div class="d-flex justify-content-end gap-2">
                                <button type="reset" class="btn btn-light rounded-pill px-4">Reset</button>
                                <button type="submit" class="btn rounded-pill px-4 text-white" style="background: linear-gradient(135deg, #5e5ce6, #7b68ee);">
                                    <i class="fa-solid fa-key me-2"></i>Update Password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Active Sessions -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">
                    <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-desktop me-2" style="color: #5e5ce6;"></i>Active Sessions</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 mb-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                    <i class="fa-solid fa-desktop text-success"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small">Windows — Chrome</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Cairo, Egypt · Current session</div>
                                </div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-3 border rounded-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                    <i class="fa-solid fa-mobile-screen text-muted"></i>
                                </div>
                                <div>
                                    <div class="fw-bold small">iPhone — Safari</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Cairo, Egypt · 2 days ago</div>
                                </div>
                            </div>
                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" style="font-size: 0.75rem;">Revoke</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
