@using UI.Areas.Admin.Models
@model SystemSettingsViewModel
@{ ViewBag.Title = "System Settings"; }

<div class="mb-4">
    <a asp-action="Index" asp-controller="Dashboard" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> back to dashboard</a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3 border-bottom">
        <h4 class="mb-1"><i class="fa-solid fa-gear" style="color: #5e5ce6"></i> System Settings</h4>
        <p class="text-muted mb-0 small">Manage global destinations and operational status for regional logistics routing.</p>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" asp-controller="Setting" method="post">
            
            <div class="mb-3">
                <label asp-for="KilometerRate" class="form-label">Kilometer Rate ($)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="KilometerRate" type="number" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="KilometerRate" class="text-danger"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="KilogramRate" class="form-label">Kilogram Rate ($)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="KilogramRate" type="number" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="KilogramRate" class="text-danger"></span>
            </div>
            
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="fa-solid fa-circle-info me-2"></i>
                <div>
                    These rates will act as multipliers for shipping types.
                </div>
            </div>
            
            <div class="d-grid">
                <button type="submit" class="btn btn-sf-primary btn-lg w-100">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<div class="text-center mt-4">
    <span class="badge badge-active py-2 px-3 border"><i class="fa-solid fa-bolt text-warning me-1"></i> REAL-TIME CALCULATION ENGINE ACTIVE</span>
    <p class="text-muted mt-2 small">System version 1.0.0</p>
</div>

<footer class="text-center mt-5 mb-3 text-muted small">
    &copy; @DateTime.Now.Year ShipmentFlow. All rights reserved.
</footer>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
