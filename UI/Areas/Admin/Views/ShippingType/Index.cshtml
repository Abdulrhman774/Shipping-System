@using UI.Areas.Admin.Models
@model ManagementPageViewModel<ShippingTypeRowItem>
@{ ViewBag.Title = "Shipping Type Management"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1">Shipping Type Management</h4>
        <p class="text-muted mb-0">Manage global destinations and operational status for regional logistics routing.</p>
    </div>
    <a asp-action="Create" class="btn btn-sf-primary">+ Add New Shipping Type</a>
</div>

<div class="sf-filter-bar card p-3 mb-4 shadow-sm">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Search</label>
            <input type="text" name="search" class="form-control" placeholder="Search by name..." value="@Context.Request.Query["search"]" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sf-primary w-100 mb-2">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0"><i class="fa-solid fa-box" style="color: #5e5ce6"></i> Registered Shipping Types <span class="badge bg-secondary ms-2">@Model.Items.Count</span></h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table sf-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>ENGLISH NAME</th>
                        <th>ARABIC NAME</th>
                        <th>SHIPPING FACTOR</th>
                        <th>STATUS</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.EnglishName</td>
                            <td>@item.ArabicName</td>
                            <td style="color: #5e5ce6; font-weight: bold;">@item.ShippingFactor</td>
                            <td>
                                @await Html.PartialAsync("_StatusBadge", item.Status)
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary sf-action-btn me-2"><i class="fa-solid fa-pen"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this shipping type?');">
                                    <button type="submit" class="btn btn-sm btn-sf-outline-danger sf-action-btn"><i class="fa-solid fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white py-3">
        @await Html.PartialAsync("_Pagination", Model.Pagination)
    </div>
</div>
