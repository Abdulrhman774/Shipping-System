@using UI.Areas.Admin.Models
@model UserSubscriptionFormViewModel
@{ ViewBag.Title = "Edit Subscription"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted">
        <i class="fas fa-arrow-left me-1"></i> back to subscriptions
    </a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3">
        <h4 class="mb-0">Edit Subscription</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="UserId" class="form-label">User <span class="text-danger">*</span></label>
                <select asp-for="UserId" asp-items="Model.Users" class="form-select">
                    <option value="">Select User</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="PackageId" class="form-label">Package <span class="text-danger">*</span></label>
                <select asp-for="PackageId" asp-items="Model.Packages" class="form-select">
                    <option value="">Select Package</option>
                </select>
                <span asp-validation-for="PackageId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubscriptionDate" class="form-label">Subscription Date <span class="text-danger">*</span></label>
                <input asp-for="SubscriptionDate" class="form-control" type="date" />
                <span asp-validation-for="SubscriptionDate" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check ps-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active Status</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-sf-primary">Update</button>
            </div>
        </form>
    </div>
</div>
