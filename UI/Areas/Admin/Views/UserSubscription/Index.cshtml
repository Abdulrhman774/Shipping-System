@using UI.Areas.Admin.Models
@model ManagementPageViewModel<UserSubscriptionRowItem>
@{ ViewBag.Title = "User Subscriptions"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">User Subscriptions</h3>
        <p class="text-muted mb-0">Manage user package subscriptions and quotas.</p>
    </div>
    <a asp-action="Create" class="btn btn-sf-primary">
        <i class="fas fa-plus me-1"></i> Add New Subscription
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body bg-light sf-filter-bar">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search subscriptions..." value="">
            </div>
            <div class="col-md-3">
                <select name="packageId" class="form-select">
                    <option value="">All Tiers</option>
                    <option value="1">Basic</option>
                    <option value="2">Pro</option>
                    <option value="3">Enterprise</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Expired">Expired</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <i class="fas fa-bolt text-warning me-2"></i>
            <span class="fw-bold me-2">SUBSCRIPTION RECORDS</span>
            <span class="badge bg-secondary rounded-pill me-3">5 active</span>
        </div>
        <div class="text-muted small fw-bold">
            ENTERPRISE CONSOLE
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle sf-table mb-0">
            <thead class="table-light">
                <tr>
                    <th>USER</th>
                    <th>PACKAGE</th>
                    <th>SUBSCRIBED DATE</th>
                    <th>USED SHIPMENTS</th>
                    <th>EXPIRY DATE</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var progressPercentage = item.TotalShipments > 0 ? (int)((double)item.UsedShipments / item.TotalShipments * 100) : 0;
                        var progressColor = progressPercentage < 80 ? "bg-success" : (progressPercentage < 100 ? "bg-warning" : "bg-danger");

                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-user text-primary me-3 fs-4"></i>
                                    <div>
                                        <div class="fw-bold">@item.UserName</div>
                                        <div class="text-muted small">@item.SubId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="d-flex align-items-center">
                                    <span class="rounded-circle d-inline-block me-2" style="width:10px; height:10px; background-color:#5e5ce6;"></span>
                                    @item.PackageName
                                </span>
                            </td>
                            <td><i class="far fa-calendar-alt text-muted me-1"></i> @item.SubscribedDate</td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@item.UsedShipments / @item.TotalShipments</span>
                                    <span>@progressPercentage%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @progressColor" role="progressbar" style="width: @progressPercentage%;" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                            <td>@item.ExpiryDate</td>
                            <td>
                                @if (item.Status == enShipmentStatus.Created)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else if (item.Status == enShipmentStatus.Returned)
                                {
                                    <span class="badge badge-expired">Expired</span>
                                }
                                else
                                {
                                    <span class="badge badge-default">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary sf-action-btn">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this subscription?');">
                                    <button type="submit" class="btn btn-sm btn-sf-outline-danger sf-action-btn">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                                <button class="btn btn-sm btn-light sf-action-btn ms-1"><i class="fas fa-ellipsis-v"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No subscriptions found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model.Pagination)
</div>
