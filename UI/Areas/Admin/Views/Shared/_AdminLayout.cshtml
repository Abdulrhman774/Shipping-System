<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - ShipmentFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/admin/css/site.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <aside class="sf-sidebar">
        <div class="sf-sidebar-logo">
            <div class="sf-sidebar-logo-icon">
                <i class="fa-solid fa-rotate"></i>
            </div>
            ShipmentFlow
        </div>

        <ul class="sf-sidebar-nav">
            <!-- Dashboard -->
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fa-solid fa-border-all fa-fw"></i> Dashboard
                </a>
            </li>

            <!-- Shipments -->
            <li>
                <a asp-area="Admin" asp-controller="Shipment" asp-action="Index">
                    <i class="fa-solid fa-ship fa-fw"></i> Shipments
                </a>
            </li>

            <!-- Settings Section (Collapsible) -->
            <li class="sf-nav-section">
                <a href="#settingsSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="sf-nav-toggle">
                    <i class="fa-solid fa-gear fa-fw"></i> Settings
                    <i class="fa-solid fa-chevron-down sf-chevron ms-auto"></i>
                </a>
                <ul class="collapse sf-submenu" id="settingsSubmenu">
                    <li>
                        <a asp-area="Admin" asp-controller="Country" asp-action="Index">
                            <i class="fa-solid fa-globe fa-fw"></i> Countries
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="City" asp-action="Index">
                            <i class="fa-solid fa-city fa-fw"></i> Cities
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Carrier" asp-action="Index">
                            <i class="fa-solid fa-truck-fast fa-fw"></i> Carriers
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="ShippingType" asp-action="Index">
                            <i class="fa-solid fa-tags fa-fw"></i> Shipping Types
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="PaymentMethod" asp-action="Index">
                            <i class="fa-solid fa-credit-card fa-fw"></i> Payment Methods
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Setting" asp-action="Edit">
                            <i class="fa-solid fa-sliders fa-fw"></i> System Settings
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Users Section (Collapsible) -->
            <li class="sf-nav-section">
                <a href="#usersSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="sf-nav-toggle">
                    <i class="fa-solid fa-users fa-fw"></i> Users
                    <i class="fa-solid fa-chevron-down sf-chevron ms-auto"></i>
                </a>
                <ul class="collapse sf-submenu" id="usersSubmenu">
                    <li>
                        <a asp-area="Admin" asp-controller="UserSender" asp-action="Index">
                            <i class="fa-solid fa-paper-plane fa-fw"></i> Senders
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="UserReceiver" asp-action="Index">
                            <i class="fa-solid fa-inbox fa-fw"></i> Receivers
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="UserSubscription" asp-action="Index">
                            <i class="fa-solid fa-id-card fa-fw"></i> Subscriptions
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="SubscriptionPackage" asp-action="Index">
                            <i class="fa-solid fa-cubes fa-fw"></i> Packages
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Reports -->
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Analytics">
                    <i class="fa-solid fa-chart-bar fa-fw"></i> Reports
                </a>
            </li>
        </ul>

        <div class="sf-sidebar-footer">
            <a href="#">
                <i class="fa-solid fa-circle-question fa-fw"></i> Help & Support
            </a>
            <div class="sf-watermark">Made with ❤ Visily</div>
        </div>
    </aside>

    <!-- Top Navbar -->
    <header class="sf-top-navbar">
        <div class="d-flex align-items-center gap-3">
            <button class="sf-icon-btn d-md-none sf-sidebar-toggle" type="button">
                <i class="fa-solid fa-bars"></i>
            </button>
            <h6 class="mb-0 fw-bold">Shipment Management</h6>
        </div>
        <div class="sf-navbar-right">
            <div class="sf-search-wrap d-none d-md-block">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search shipments...">
            </div>
            <button class="sf-icon-btn position-relative">
                <i class="fa-regular fa-bell"></i>
                <span class="sf-dot"></span>
            </button>
            <button class="sf-icon-btn">
                <i class="fa-solid fa-gear"></i>
            </button>
            <div class="sf-separator"></div>
            <div class="dropdown">
                <div class="sf-user-menu" data-bs-toggle="dropdown" role="button">
                    <div class="sf-user-info text-end d-none d-sm-flex flex-column">
                        <span class="sf-user-name">Alex Rivers</span>
                        <span class="sf-user-role">Admin</span>
                    </div>
                    <div class="sf-user-avatar">AR</div>
                    <i class="fa-solid fa-caret-down text-muted" style="font-size:0.75rem;"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                    <li><a class="dropdown-item" href="#"><i class="fa-regular fa-user me-2"></i>Profile</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="sf-main-content">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/admin/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
