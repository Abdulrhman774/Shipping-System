@model UI.Areas.Admin.Models.PaginationModel
@{
    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "";

    string BuildPageUrl(int page)
    {
        var q = new List<string>();
        q.Add($"page={page}");
        if (!string.IsNullOrEmpty(search))
            q.Add($"search={Uri.EscapeDataString(search)}");
        if (!string.IsNullOrEmpty(status))
            q.Add($"status={Uri.EscapeDataString(status)}");
        return "?" + string.Join("&", q);
    }

    int startIndex = (Model.CurrentPage - 1) * Model.PageSize + 1;
    int endIndex = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
    bool hasPreviousPage = Model.CurrentPage > 1;
    bool hasNextPage = Model.CurrentPage < Model.TotalPages;
    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, startPage + 4);
    if (endPage - startPage < 4) startPage = Math.Max(1, endPage - 4);

    // تعريف الأنماط المضمنة (Inline Styles)
    string baseBtn = "display:inline-flex;align-items:center;justify-content:center;gap:6px;height:42px;min-width:42px;padding:0 16px;border-radius:8px;border:1.5px solid #d1d5db;background:#ffffff;color:#374151;font-size:14px;font-weight:500;text-decoration:none;cursor:pointer;transition:all 0.15s;";
    string activeBtn = "display:inline-flex;align-items:center;justify-content:center;gap:6px;height:42px;min-width:42px;padding:0 16px;border-radius:8px;border:1.5px solid #2563eb;background:#2563eb;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;cursor:pointer;";
    string disabledBtn = "display:inline-flex;align-items:center;justify-content:center;gap:6px;height:42px;min-width:42px;padding:0 16px;border-radius:8px;border:1.5px solid #e5e7eb;background:#f9fafb;color:#d1d5db;font-size:14px;font-weight:500;text-decoration:none;cursor:default;pointer-events:none;";
    string navBtn = "display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:8px;border:1.5px solid #d1d5db;background:#ffffff;color:#374151;font-size:14px;font-weight:500;text-decoration:none;cursor:pointer;";
    string navBtnDisabled = "display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:8px;border:1.5px solid #e5e7eb;background:#f9fafb;color:#d1d5db;font-size:14px;font-weight:500;text-decoration:none;cursor:default;pointer-events:none;";
}

<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:1rem 0;">

    @* Previous *@
    <a href="@BuildPageUrl(Model.CurrentPage - 1)"
       style="@(hasPreviousPage ? navBtn : navBtnDisabled)"
       aria-label="Previous page">
        <i class="fa-solid fa-chevron-left" style="font-size:12px;"></i> Previous
    </a>

    @* Page Numbers *@
    @for (int i = startPage; i <= endPage; i++)
    {
        <a href="@BuildPageUrl(i)"
           style="@(i == Model.CurrentPage ? activeBtn : baseBtn)"
        @(i == Model.CurrentPage ? Html.Raw("aria-current=\"page\"") : null)>@i</a>
    }

    @* Ellipsis + Last Page *@
    @if (endPage < Model.TotalPages)
    {
        <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;color:#9ca3af;font-size:16px;letter-spacing:2px;">···</span>
        <a href="@BuildPageUrl(Model.TotalPages)" style="@baseBtn">@Model.TotalPages</a>
    }

    @* Next *@
    <a href="@BuildPageUrl(Model.CurrentPage + 1)"
       style="@(hasNextPage ? navBtn : navBtnDisabled)"
       aria-label="Next page">
        Next <i class="fa-solid fa-chevron-right" style="font-size:12px;"></i>
    </a>

    @* Info *@
    <span style="margin-left:auto;font-size:13px;color:#6b7280;white-space:nowrap;">
        Showing @startIndex–@endIndex of @Model.TotalItems
    </span>

</div>