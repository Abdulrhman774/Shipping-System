@model UI.Areas.Admin.Models.PaginationModel

@{
    int startIndex = (Model.CurrentPage - 1) * Model.PageSize + 1;
    int endIndex = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
    bool hasPreviousPage = Model.CurrentPage > 1;
    bool hasNextPage = Model.CurrentPage < Model.TotalPages;

    // Show a max of 5 page buttons around current page
    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, startPage + 4);
    if (endPage - startPage < 4)
    {
        startPage = Math.Max(1, endPage - 4);
    }
}

<div class="d-flex align-items-center justify-content-between mt-4 px-3 pb-3">
    <div class="text-muted" style="font-size: 0.875rem;">
        Showing <strong>@startIndex-@endIndex</strong> of <strong>@Model.TotalItems</strong> @Model.ItemLabel
    </div>
    <div class="sf-pagination">
        <a href="#" class="sf-page-btn @(!hasPreviousPage ? "disabled" : "")">
            <i class="fa-solid fa-chevron-left"></i> Previous
        </a>

        @for (int i = startPage; i <= endPage; i++)
        {
            <a href="#" class="sf-page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
        }

        @if (endPage < Model.TotalPages)
        {
            <span class="sf-page-btn disabled">...</span>
            <a href="#" class="sf-page-btn">@Model.TotalPages</a>
        }

        <a href="#" class="sf-page-btn @(!hasNextPage ? "disabled" : "")">
            Next <i class="fa-solid fa-chevron-right"></i>
        </a>
    </div>
</div>
