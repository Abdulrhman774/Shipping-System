@model enEntityState

@{
    // تحديد الألوان والخلفية الصلبة مباشرة
    var (bgColor, textColor, badgeText) = Model switch
    {
        enEntityState.Active => ("#28a745", "#ffffff", "Active"),     // أخضر غامق + نص أبيض
        enEntityState.Inactive => ("#ffc107", "#212529", "Inactive"),   // أصفر + نص داكن
        enEntityState.Deleted => ("#dc3545", "#ffffff", "Deleted"),    // أحمر غامق + نص أبيض
        _ => ("#6c757d", "#ffffff", "Unknown")                         // رمادي + نص أبيض
    };
}

<span style="display: inline-block; min-width: 80px; padding: 0.35em 0.65em; font-size: 0.75rem; font-weight: 600; text-align: center; border-radius: 0.25rem; background-color: @bgColor; color: @textColor;">
    @badgeText
</span>