@using UI.Areas.Admin.Models
@model CityFormViewModel
@{ ViewBag.Title = "Add New City"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> back to cities</a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3 border-bottom">
        <h4 class="mb-0"><i class="fa-solid fa-city" style="color: #5e5ce6"></i> Add New City</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="EnglishName" class="form-label">English Name *</label>
                <input asp-for="EnglishName" class="form-control" />
                <span asp-validation-for="EnglishName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ArabicName" class="form-label">Arabic Name *</label>
                <input asp-for="ArabicName" class="form-control" />
                <span asp-validation-for="ArabicName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="CountryId" class="form-label">Country *</label>
                <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
                    <option value="">Select a country...</option>
                </select>
                <span asp-validation-for="CountryId" class="text-danger"></span>
            </div>
            
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            
            <div class="d-grid">
                <button type="submit" class="btn btn-sf-primary btn-lg">Save City</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
