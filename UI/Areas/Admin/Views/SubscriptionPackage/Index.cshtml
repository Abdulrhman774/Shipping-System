@using UI.Areas.Admin.Models
@model ManagementPageViewModel<SubscriptionPackageRowItem>
@{ ViewBag.Title = "Subscription Packages"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Subscription Packages</h3>
        <p class="text-muted mb-0">Define package limits and pricing for user subscriptions.</p>
    </div>
    <a asp-action="Create" class="btn btn-sf-primary">
        <i class="fas fa-plus me-1"></i> Add New Package
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body bg-light sf-filter-bar">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search packages..." value="">
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <i class="fas fa-filter text-muted me-2"></i>
            <span class="fw-bold me-2">PLAN TIERS</span>
            <span class="badge bg-secondary rounded-pill me-3">@Model.Pagination.TotalItems items</span>
        </div>
        <div class="text-muted small fw-bold">
            SORTED BY: HIERARCHY
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle sf-table mb-0">
            <thead class="table-light">
                <tr>
                    <th>PACKAGE NAME</th>
                    <th>SHIPMENT COUNT</th>
                    <th>DISTANCE (KM)</th>
                    <th>WEIGHT (KG)</th>
                    <th>PRICE ($)</th>
                    <th>DURATION (DAYS)</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-box text-primary me-3 fs-4"></i>
                                    <div>
                                        <div class="fw-bold">@item.PackageName</div>
                                        <div class="text-muted small">UID: @item.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.ShipmentCount</td>
                            <td>@item.DistanceKm</td>
                            <td>@item.WeightKg</td>
                            <td class="text-primary fw-bold">@item.Price</td>
                            <td>@item.DurationDays</td>
                            <td>
                                @await Html.PartialAsync("_StatusBadge", item.Status)
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary sf-action-btn">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this package?');">
                                    <button type="submit" class="btn btn-sm btn-sf-outline-danger sf-action-btn">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                                <button class="btn btn-sm btn-light sf-action-btn ms-1"><i class="fas fa-ellipsis-v"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No subscription packages found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model.Pagination)
</div>
