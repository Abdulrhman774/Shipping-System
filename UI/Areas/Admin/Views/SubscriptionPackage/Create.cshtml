@using UI.Areas.Admin.Models
@model SubscriptionPackageFormViewModel
@{ ViewBag.Title = "Add New Package"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> back to packages</a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3 border-bottom">
        <h4 class="mb-0"><i class="fa-solid fa-cubes" style="color: #5e5ce6"></i> Add New Subscription Package</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="PackageName" class="form-label">Package Name *</label>
                <input asp-for="PackageName" class="form-control" />
                <span asp-validation-for="PackageName" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ShipimentCount" class="form-label">Shipment Count *</label>
                    <input asp-for="ShipimentCount" type="number" class="form-control" />
                    <span asp-validation-for="ShipimentCount" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="NumberOfKiloMeters" class="form-label">Kilometers *</label>
                    <input asp-for="NumberOfKiloMeters" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="NumberOfKiloMeters" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="TotalWeight" class="form-label">Total Weight *</label>
                    <input asp-for="TotalWeight" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="TotalWeight" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            
            <div class="d-grid">
                <button type="submit" class="btn btn-sf-primary btn-lg">Save Package</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
