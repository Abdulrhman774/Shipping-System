@using UI.Areas.Admin.Models
@model SubscriptionPackageFormViewModel
@{ ViewBag.Title = "Add New Package"; }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted">
        <i class="fas fa-arrow-left me-1"></i> back to packages
    </a>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-header bg-white py-3">
        <h4 class="mb-0">Add New Package</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="PackageName" class="form-label">Package Name <span class="text-danger">*</span></label>
                <input asp-for="PackageName" class="form-control" />
                <span asp-validation-for="PackageName" class="text-danger"></span>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="ShipmentCount" class="form-label">Shipment Count <span class="text-danger">*</span></label>
                    <input asp-for="ShipmentCount" class="form-control" type="number" />
                    <span asp-validation-for="ShipmentCount" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NumberOfKiloMeters" class="form-label">Distance (KM) <span class="text-danger">*</span></label>
                    <input asp-for="NumberOfKiloMeters" class="form-control" type="number" />
                    <span asp-validation-for="NumberOfKiloMeters" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TotalWeight" class="form-label">Total Weight (KG) <span class="text-danger">*</span></label>
                    <input asp-for="TotalWeight" class="form-control" type="number" />
                    <span asp-validation-for="TotalWeight" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label">Price ($) <span class="text-danger">*</span></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DurationDays" class="form-label">Duration (Days) <span class="text-danger">*</span></label>
                <input asp-for="DurationDays" class="form-control" type="number" value="30" />
                <span asp-validation-for="DurationDays" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active Status</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-sf-primary">Save Package</button>
            </div>
        </form>
    </div>
</div>
