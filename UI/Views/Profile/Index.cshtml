                                    </ul>
                                    <div class="tab-content">
                                        <div role="tabpanel" class="tab-pane active" id="track-by-number">
                                            <h3>Air Freight Tracking</h3>
                                            <div class="put-track-number">
                                                <form action="track.html">
                                                    <input type="text" class="form-control track-id" name="trackid" placeholder="Track ID" />
                                                    <button type="submit" class="btn btn-track">Track</button>
                                                </form>
                                            </div>
                                            <div class="track-bottom-link"><a href="">Need Help?</a> <span>|</span> <a href="">Your Order list</a></div>
                                        </div>
                                        <div role="tabpanel" class="tab-pane" id="track-by-reference">
                                            <div class="put-reference-number">
                                                <form action="customer-register.html">
                                                    <div class="form-group">
                                                        <div class="row">
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label>Shipment Reference (BOL or PO):</label>
                                                                <input type="text" class="form-control" name="RefNumber" required />
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label>Shipment Date Start:</label>
                                                                <div class="input-group date" data-provide="datepicker">
                                                                    <input type="text" class="form-control" name="startDate" required />
                                                                    <div class="input-group-addon"><span class="glyphicon glyphicon-th"></span></div>
                                                                </div>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label>Shipment Date End:</label>
                                                                <div class="input-group date" data-provide="datepicker">
                                                                    <input type="text" class="form-control" name="EndDate" required />
                                                                    <div class="input-group-addon"><span class="glyphicon glyphicon-th"></span></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="row">
                                                            <div class="col-12 col-md-6 col-lg-6">
                                                                <label>Origin Country:</label>
                                                                <select class="form-control" name="OriginCountry">
                                                                    <option>United State</option>
                                                                    <option>Canada</option>
                                                                    <option>Maxico</option>
                                                                    <option>Caina</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-6">
                                                                <label>Origin ZIP/Postal Code:</label>
                                                                <input type="text" class="form-control" name="OriginZip" required />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="row">
                                                            <div class="col-12 col-md-6 col-lg-6">
                                                                <label>Destination Country: </label>
                                                                <select class="form-control" name="dcountry">
                                                                    <option>United State</option>
                                                                    <option>Canada</option>
                                                                    <option>Maxico</option>
                                                                    <option>Caina</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-6">
                                                                <label>Destination ZIP/Postal Code:</label>
                                                                <input type="text" class="form-control" name="DZip" required />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <button type="submit" class="btn btn-submit">Track</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
