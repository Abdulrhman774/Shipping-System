@model ProfileViewModel
@{
    ViewData["Title"] = "Customer Profile";
    Layout = "_Layout";
}

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Customer Profile</h1>
                <a href="/" title="Home">Home</a> / Customer Profile
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->

<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="right-block left-menu menu-with-title mb15">
                    <ul class="nav flex-column" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="editprofile-tab" data-toggle="tab" href="#editprofile" role="tab" aria-controls="editprofile" aria-selected="true">
                                <i class="fa fa-UserData"></i> Edit Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="shipmenttracking-tab" data-toggle="tab" href="#shipmenttracking" role="tab" aria-controls="shipmenttracking" aria-selected="false">
                                <i class="fa fa-search"></i> Shipment Tracking
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="CurrentShipment-tab" data-toggle="tab" href="#CurrentShipment" role="tab" aria-controls="CurrentShipment" aria-selected="false">
                                <i class="fa fa-truck"></i> Current Shipment
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="ShipmentHistory-tab" data-toggle="tab" href="#ShipmentHistory" role="tab" aria-controls="ShipmentHistory" aria-selected="false">
                                <i class="fa fa-list"></i> Shipment History
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="tab-content" id="myTabContent">

                    <!-- ============================================ -->
                    <!--            TAB 1: Edit Profile -->
                    <!-- ============================================ -->
                    <!-- ============================================ -->
                    <!-- TAB 1: Edit Profile (مع تبويبات فرعية) -->
                    <!-- ============================================ -->
                    <div class="tab-pane fade show active" id="editprofile" role="tabpanel" aria-labelledby="editprofile-tab">
                        <div class="profile-settings">
                            <!-- تبويبات فرعية -->
                            <ul class="nav nav-tabs" id="editProfileTabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="UserDatadata-tab" data-toggle="tab" href="#UserDatadata" role="tab" aria-controls="UserDatadata" aria-selected="true">
                                        <i class="fa fa-UserData"></i> UserData Data
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="changepassword-tab" data-toggle="tab" href="#changepassword" role="tab" aria-controls="changepassword" aria-selected="false">
                                        <i class="fa fa-key"></i> Change Password
                                    </a>
                                </li>
                            </ul>

                            <div class="tab-content" id="editProfileTabContent">
                                <!-- ====== TAB 1: UserData Data ====== -->
                                <div class="tab-pane fade show active" id="UserDatadata" role="tabpanel" aria-labelledby="UserDatadata-tab">
                                    <div class="customer-login-block mt-3">
                                        <h2>UserData Data</h2>
                                        <form asp-action="Update" method="post" enctype="multipart/form-data">
                                            @Html.AntiForgeryToken()

                                            @if (TempData["ErrorMessage"] != null)
                                            {
                                                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                                            }
                                            @if (TempData["SuccessMessage"] != null)
                                            {
                                                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                                            }

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-3 col-lg-3">
                                                        <label for="fileToUpload">
                                                            <div class="profile-pic" style="background-image: url('@(Model.UserData?.ImageUrl ?? "/assets/images/profile.jpg")')">
                                                                <span>Change Image</span>
                                                            </div>
                                                        </label>
                                                        <input type="file" name="fileToUpload" id="fileToUpload" class="form-control-file">
                                                    </div>
                                                    <div class="col-12 col-md-9 col-lg-9 align-content-center">
                                                        <h4>@(Model.UserData?.FirstName ?? "") @(Model.UserData?.SecondName ?? "") @(Model.UserData?.LastName ?? "")</h4>
                                                        <h6>@(Model.UserData?.Email ?? "email@example.com")</h6>
                                                        <span>@(Model.UserData?.PhoneNumber ?? "+20 100 000 0000")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>First Name <sup>*</sup></label>
                                                        <input asp-for="UserData.FirstName" class="form-control" placeholder="First Name" />
                                                        <span asp-validation-for="UserData.FirstName" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Second Name <sup>*</sup></label>
                                                        <input asp-for="UserData.SecondName" class="form-control" placeholder="Second Name" />
                                                        <span asp-validation-for="UserData.SecondName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Third Name</label>
                                                        <input asp-for="UserData.ThirdName" class="form-control" placeholder="Third Name (optional)" />
                                                        <span asp-validation-for="UserData.ThirdName" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Last Name <sup>*</sup></label>
                                                        <input asp-for="UserData.LastName" class="form-control" placeholder="Last Name" />
                                                        <span asp-validation-for="UserData.LastName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Date of Birth <sup>*</sup></label>
                                                        <input asp-for="UserData.DateOfBirth" type="date" class="form-control"
                                                               value="@(Model.UserData?.DateOfBirth.ToString("yyyy-MM-dd"))" />
                                                        <span asp-validation-for="UserData.DateOfBirth" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Gender <sup>*</sup></label>
                                                        <select asp-for="UserData.Gender" asp-items="Html.GetEnumSelectList<enGender>()" class="form-control">
                                                            <option value="">-- Select Gender --</option>
                                                        </select>
                                                        <span asp-validation-for="UserData.Gender" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Email <sup>*</sup></label>
                                                        <input asp-for="UserData.Email" type="email" class="form-control" placeholder="Email" />
                                                        <span asp-validation-for="UserData.Email" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6 col-lg-6">
                                                        <label>Phone <sup>*</sup></label>
                                                        <input asp-for="UserData.PhoneNumber" class="form-control" placeholder="Phone Number" />
                                                        <span asp-validation-for="UserData.PhoneNumber" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="submit" class="btn btn-submit" asp-action="ChangeUserData">
                                                <i class="fa fa-save"></i> Save Changes
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- ====== TAB 2: Change Password ====== -->
                                <div class="tab-pane fade" id="changepassword" role="tabpanel" aria-labelledby="changepassword-tab">
                                    <div class="customer-login-block mt-3">
                                        <h2>Change Password</h2>
                                        <form asp-action="ChangePassword" method="post">
                                            @Html.AntiForgeryToken()

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12">
                                                        <label>Current Password <sup>*</sup></label>
                                                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" />
                                                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="row">
                                                    <div class="col-12 col-md-6">
                                                        <label>New Password <sup>*</sup></label>
                                                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" />
                                                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label>Confirm Password <sup>*</sup></label>
                                                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" />
                                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div asp-validation-summary="All" class="text-danger"></div>

                                            <button type="submit" class="btn btn-submit">
                                                <i class="fa fa-key"></i> Change Password
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ============================================ -->
                    <!-- TAB 2: Shipment Tracking (تم التعديل) -->
                    <!-- ============================================ -->
                    <div class="tab-pane fade" id="shipmenttracking" role="tabpanel" aria-labelledby="shipmenttracking-tab">
                        <div class="row justify-content-center">
                            <div class="col-12 col-lg-12">
                                <div class="tracking-block">
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active" href="#track-by-number" aria-controls="track-by-number" role="tab" data-toggle="tab">Track by Number</a>
                                        </li>
                                    </ul>
                                    <div class="tab-content">
                                        <div role="tabpanel" class="tab-pane active" id="track-by-number">
                                            <h3>Track Your Shipment</h3>
                                            <div class="put-track-number">
                                                @* ✅ Form واحد فقط يروح لـ Tracking/Result *@
                                                <form asp-controller="Tracking" asp-action="Result" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="row">
                                                        <div class="col-12 col-lg-8">
                                                            <input type="text" class="form-control track-id" name="trackingNumber" placeholder="Enter Tracking Number" />
                                                        </div>
                                                        <div class="col-12 col-lg-4">
                                                            <button type="submit" class="btn btn-track" style="width:100%;">
                                                                <i class="fa fa-search"></i> Track
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                            <div class="track-bottom-link mt-3">
                                                <a asp-controller="Tracking" asp-action="Index">Go to Tracking Page</a>
                                                <span>|</span>
                                                <a asp-controller="Shipment" asp-action="History">Your Order List</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- TAB 3: Current Shipment (Active) -->
                    <!-- ============================================ -->
                    <div class="tab-pane fade" id="CurrentShipment" role="tabpanel" aria-labelledby="CurrentShipment-tab">
                        <div class="row">
                            <div class="col-12 col-lg-12">
                                <div class="order-list">
                                    <h3>Your Current Shipments</h3>
                                    @if (Model.ActiveShipments != null && Model.ActiveShipments.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Tracking #</th>
                                                        <th>Sender</th>
                                                        <th>Receiver</th>
                                                        <th>Shipping Date</th>
                                                        <th>Weight</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.ActiveShipments)
                                                    {
                                                        <tr>
                                                            <td><strong>@item.TrackingNumber</strong></td>
                                                            <td>@item.SenderName</td>
                                                            <td>@item.ReceiverName</td>
                                                            <td>@item.ShippingDate.ToString("dd MMM yyyy")</td>
                                                            <td>@item.Weight.ToString("F2") kg</td>
                                                            <td>
                                                                <span class="badge badge-success">Active</span>
                                                            </td>
                                                            <td>
                                                                @* ✅ زر Edit *@
                                                                <a asp-controller="Shipment" asp-action="Update" asp-route-id="@item.ShipmentId" title="Edit" class="btn btn-sm btn-outline-warning">
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                @* ✅ زر View Details *@
                                                                <a asp-controller="Shipment" asp-action="Details" asp-route-id="@item.ShipmentId" title="View Details" class="btn btn-sm btn-outline-primary">
                                                                    <i class="fa fa-eye"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4">
                                            <i class="fas fa-box fa-3x text-muted mb-3"></i>
                                            <h5>No Active Shipments</h5>
                                            <p>You don't have any active shipments at the moment.</p>
                                            <a asp-controller="Shipment" asp-action="Create" class="wshipping-button">Create New Shipment</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ============================================ -->
                    <!-- TAB 4: Shipment History -->
                    <!-- ============================================ -->
                    <div class="tab-pane fade" id="ShipmentHistory" role="tabpanel" aria-labelledby="ShipmentHistory-tab">
                        <div class="row">
                            <div class="col-12 col-lg-12">
                                <div class="order-list">
                                    <h3>Your Shipment History</h3>
                                    @if (Model.ShipmentHistory != null && Model.ShipmentHistory.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Tracking #</th>
                                                        <th>Sender</th>
                                                        <th>Receiver</th>
                                                        <th>Shipping Date</th>
                                                        <th>Weight</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.ShipmentHistory)
                                                    {
                                                        <tr>
                                                            <td><strong>@item.TrackingNumber</strong></td>
                                                            <td>@item.SenderName</td>
                                                            <td>@item.ReceiverName</td>
                                                            <td>@item.ShippingDate.ToString("dd MMM yyyy")</td>
                                                            <td>@item.Weight.ToString("F2") kg</td>
                                                            <td>
                                                                @{
                                                                    var statusClass = item.CurrentState switch
                                                                    {
                                                                        enEntityState.Active => "badge-success",
                                                                        enEntityState.Inactive => "badge-warning",
                                                                        enEntityState.Deleted => "badge-danger",
                                                                        _ => "badge-secondary"
                                                                    };
                                                                    var statusText = item.CurrentState switch
                                                                    {
                                                                        enEntityState.Active => "Active",
                                                                        enEntityState.Inactive => "In Transit",
                                                                        enEntityState.Deleted => "Delivered",
                                                                        _ => "Unknown"
                                                                    };
                                                                }
                                                                <span class="badge @statusClass">@statusText</span>
                                                            </td>
                                                            <td>
                                                                @* ✅ زر Edit *@
                                                                <a asp-controller="Shipment" asp-action="Update" asp-route-id="@item.ShipmentId" title="Edit" class="btn btn-sm btn-outline-warning" style="margin-right:3px;">
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                @* ✅ زر View Details *@
                                                                <a asp-controller="Shipment" asp-action="Details" asp-route-id="@item.ShipmentId" title="View Details" class="btn btn-sm btn-outline-primary">
                                                                    <i class="fa fa-eye"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4">
                                            <i class="fas fa-box fa-3x text-muted mb-3"></i>
                                            <h5>No Shipments Found</h5>
                                            <p>You haven't created any shipments yet.</p>
                                            <a asp-controller="Shipment" asp-action="CreateShipment" class="wshipping-button">Create Your First Shipment</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var hash = window.location.hash;
            if (hash) {
                $('.nav-link[href="' + hash + '"]').tab('show');
            }
        });
    </script>
}