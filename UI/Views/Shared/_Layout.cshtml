<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - W-shipping</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ui.styles.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/png" href="/assets/images/fevicon.png">

    <!-- Bootstrap LTR CSS -->
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">

    <!-- Font awesome CSS -->
    <link rel="stylesheet" href="/assets/css/fontawesome.all.min.css">

    <!-- Animate CSS -->
    <link rel="stylesheet" href="/assets/css/animate.min.css">

    <!-- OwlCarousel CSS -->
    <link rel="stylesheet" href="/assets/css/owl.carousel.min.css">

    <!-- Magnific popup CSS -->
    <link rel="stylesheet" href="/assets/css/fancybox.min.css">

    <!-- chat CSS -->
    <link rel="stylesheet" href="/assets/css/chat.css">

    <!-- Slicknav CSS -->
    <link rel="stylesheet" href="/assets/css/slicknav.min.css">

    <!-- Date picker CSS -->
    <link rel="stylesheet" href="/assets/css/bootstrap-datetimepicker.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet" href="/assets/css/style.css">

    <!-- Responsive CSS -->
    <link rel="stylesheet" href="/assets/css/responsive.css">

    <!-- RTL CSS -->
    <!-- <link rel="stylesheet" href="/assets/css/rtl.css"> -->
    <!-- jQuery -->
    <script src="/assets/js/jquery-3.4.1.min.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Main Wrapper Start -->
    <div class="main-wrapper">

        <!-- skiptocontent start ( This section for blind and Google SEO, Also for page speed )-->
        <a id="skiptocontent" href="#maincontent">skip navigation</a>
        <!-- skiptocontent End -->
        <!-- Preloader start -->
        <div class="wshipping-site-preloader-wrapper">
            <div class="spinner">
                <div class="double-bounce1"></div>
                <div class="double-bounce2"></div>
            </div>
        </div>
        <!-- Preloader End -->

        <header class="for-sticky">
            <!-- Header top area start -->
            <div class="header-top-area">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-8">
                            <div class="top-contact">
                                <a href="#"><i class="fa fa-envelope"></i> abdulrhmanazmy980@gmail.com</a>
                                <a href="#"><i class="fa fa-phone"></i> +20 1509017716</a>
                                <a href="#"><i class="far fa-clock"></i> 9:00AM to 8:00PM</a>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 d-flex justify-content-center justify-content-lg-end align-items-center">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- ✅ لو مسجل دخول -->
                                <div class="top-menu">
                                    <ul class="d-flex align-items-center" style="margin:0; padding:0; list-style:none;">
                                        <li style="margin-right:15px;">
                                            <a asp-controller="Profile" asp-action="Index" style="color:#eeeeee; text-decoration:none;">
                                                <i class="fas fa-user"></i>
                                                @{
                                                    var displayName = User.Identity?.Name ?? "User";
                                                    if (!string.IsNullOrEmpty(displayName) && displayName.Contains("@"))
                                                    {
                                                        displayName = displayName.Split('@')[0];
                                                    }
                                                }
                                                @displayName
                                            </a>
                                        </li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline; margin:0;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" style="background:none; border:none; color:#eeeeee; cursor:pointer; padding:0; display:inline; font-size:14px; text-decoration:none;">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <!-- ✅ لو مش مسجل دخول -->
                                <div class="top-menu">
                                    <ul class="d-flex align-items-center" style="margin:0; padding:0; list-style:none;">
                                        <li style="margin-right:15px;">
                                            <a asp-controller="Account" asp-action="Login" style="color:#eeeeee; text-decoration:none;">
                                                <i class="fas fa-sign-in-alt"></i> Login
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Account" asp-action="Register" style="color:#eeeeee; text-decoration:none;">
                                                <i class="fa fa-unlock-alt"></i> Registration
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }

                            <!-- Language Dropdown -->
                            <div class="language" style="margin-left:15px; padding-left:15px; border-left:1px solid #555;">
                                <ul style="margin:0; padding:0; list-style:none;">
                                    <li>
                                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="color:#eeeeee; text-decoration:none;">
                                            <img src="/assets/images/flag-1.png" alt="" style="max-width:18px; margin-right:3px;" /> EN
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li><a href="#"><img src="/assets/images/flag-1.png" alt="" /> EN</a></li>
                                            <li><a href="#"><img src="/assets/images/flag-2.png" alt="" /> TR</a></li>
                                            <li><a href="#"><img src="/assets/images/flag-3.png" alt="" /> BR</a></li>
                                            <li><a href="#"><img src="/assets/images/flag-4.png" alt="" /> SR</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- Header top area End -->
            <!-- Header area start -->
            <div class="header-area">
                <div class="container">
                    <!-- Site logo Start -->
                    <div class="logo">
                        <a asp-controller="Home" asp-action="Index" title="W-shipping">
                            <img src="/assets/images/logo.png" alt="W-shipping" />
                        </a>
                    </div>
                    <!-- Site logo end -->
                    <div class="mobile-menu-wrapper"></div>

                    <!-- Main menu start -->
                    <nav class="mainmenu">
                        <ul id="navigation">
                            <li>
                                <a asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>
                                <a asp-controller="About" asp-action="Index">About Us</a>
                            </li>
                            <li>
                                <a asp-controller="Services" asp-action="Index">Services</a>
                            </li>
                            <li>
                                <a asp-controller="Shipment" asp-action="Create">Shipping</a>
                            </li>
                            <li>
                                <a asp-controller="Blog" asp-action="Index">Blog</a>
                            </li>
                            <li>
                                <a asp-controller="Contact" asp-action="Index">Contact Us</a>
                            </li>
                            <li>
                                <a asp-controller="Profile" asp-action="Index">
                                    <img class="header-profile-pic" src="/assets/images/profile.jpg" /> Profile
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <!-- Main menu end -->
                </div>
            </div>
            <!-- Header area End -->
        </header>

        <partial name="_ToastNotifications" />

        @RenderBody()

        <!-- Footer start -->
        <footer class="site-footer">
            <div class="footer-top-area">
                <div class="container">
                    <div class="row">
                        <!-- العمود الأول: Logo والمعلومات -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz">
                                <h3 class="footer-logo">
                                    <a asp-controller="Home" asp-action="Index">
                                        <img src="/assets/images/footer-logo.png" alt="footer logo" />
                                    </a>
                                </h3>
                                <p>It was popularised in the 1960s with the release of Letraset sheets containing.</p>
                                <ul class="footer-contact">
                                    <li><i class="fa fa-phone"></i> +88 01xxx 8xxx04</li>
                                    <li><i class="fa fa-envelope"></i> info@companyname.com</li>
                                    <li><i class="fa fa-fax"></i> +88 x2 1xx4x6</li>
                                </ul>
                            </div>
                            <div class="top-social bottom-social">
                                <a href="#"><i class="fab fa-facebook-f"></i></a>
                                <a href="#"><i class="fab fa-twitter"></i></a>
                                <a href="#"><i class="fab fa-youtube"></i></a>
                                <a href="#"><i class="fa fa-rss"></i></a>
                            </div>
                        </div>

                        <!-- العمود الثاني: Quick Links -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz footer-menu">
                                <h3 class="footer-wiz-title">Quick Links</h3>
                                <ul>
                                    <li><a asp-controller="About" asp-action="Index">Company Overview</a></li>
                                    <li><a asp-controller="Services" asp-action="Index">Our Services</a></li>
                                    <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                                    <li><a asp-controller="Contact" asp-action="Index">Contact Us</a></li>
                                </ul>
                            </div>
                        </div>

                        <!-- العمود الثالث: Useful Links -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz footer-menu">
                                <h3 class="footer-wiz-title">Useful Links</h3>
                                <ul>
                                    <li><a asp-controller="Shipment" asp-action="Create">Create Shipping</a></li>
                                    <li><a asp-controller="Tracking" asp-action="Index">Tracking</a></li>
                                    <li><a asp-controller="Shipment" asp-action="History">Shipment History</a></li>
                                    <li><a asp-controller="Tracking" asp-action="Result">Tracking Result</a></li>
                                </ul>
                            </div>
                        </div>

                        <!-- العمود الرابع: Opening Hours & Newsletter -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz">
                                <h3 class="footer-wiz-title">Opening Hours</h3>
                                <ul class="open-hours">
                                    <li><span>Mon to Fri:</span> <span class="text-right">09:30AM to 05:30PM</span></li>
                                    <li><span>Sun:</span> <span class="text-right">Closed</span></li>
                                </ul>
                                <div class="newsletter">
                                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                                        <input type="email" name="email" placeholder="Enter your email" value="" class="news-input" required>
                                        <button type="submit" value="" class="news-btn"><i class="fa fa-location-arrow"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- footer top end -->
            <!-- copyright start -->
            <div class="footer-bottom-area">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-6 wow fadeInLeft">
                            Copyright © 2026 <span>World shipping</span>. All Rights Reserved
                        </div>
                        <div class="col-12 col-lg-6 text-right wow fadeInRight">
                            Design & Development By: <a href="#" title="companytitle" target="_blank">Company Title</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- copyright end -->
        </footer>
        <!-- Footer end -->
    </div>
    <!-- Main Wrapper end -->
    <!-- Start scroll top -->
    <div class="scrollup"><i class="fas fa-chevron-up"></i></div>
    <!-- End scroll top -->
    <!-- Tether JS -->
    <script src="/assets/js/tether.min.js"></script>

    <!-- Popper JS -->
    <script src="/assets/js/popper.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="/assets/js/bootstrap.min.js"></script>

    <!-- OwlCarousel JS -->
    <script src="/assets/js/owl.carousel.min.js"></script>

    <!-- Bootstrap dateTimePicker -->
    <script src="/assets/js/datetimepicker-moment.min.js"></script>
    <script src="/assets/js/bootstrap-datetimepicker.min.js"></script>

    <!-- SlickNav JS -->
    <script src="/assets/js/jquery.slicknav.min.js"></script>

    <!-- fancybox Popup JS -->
    <script src="/assets/js/jquery.fancybox.min.js"></script>

    <!-- WOW JS -->
    <script src="/assets/js/wow-1.3.0.min.js"></script>

    <!-- Step Form with validate -->
    <script src="/assets/js/jquery.validate.js"></script>
    <script src="/assets/js/form-step.js"></script>

    <!-- SlickNav JS -->
    <script src="/assets/js/youtube-background.js"></script>

    <!-- Gallery Filter -->
    <script src="/assets/js/jquery.filterizr.min.js"></script>

    <!-- Chat JS -->
    <script src="/assets/js/chat.js"></script>

    <!-- Coming Soon JS -->
    <script src="/assets/js/coming-soon.js"></script>

    <!-- Active JS -->
    <script src="/assets/js/active.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>