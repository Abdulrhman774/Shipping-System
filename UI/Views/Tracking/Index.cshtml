<!-- Views/Tracking/Index.cshtml -->
@{
    ViewData["Title"] = "Tracking";
}

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Tracking</h1>
                <a href="@Url.Action("Index", "Home")" title="Home">Home</a> / Tracking
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>We freight to all over the world<br />The best logistic company, <span>FAST</span> and <span>SAFELY!</span></h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->

<!-- Tracking start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="section-title wow fadeInUp">
                    <h2>Track a shipment</h2>
                    <p>Track your LTL, truckload, or intermodal shipment by entering your <span>Track number</span> below to get instant freight tracking information.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-lg-9">
                <div class="tracking-block">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" href="#track-by-number" aria-controls="track-by-number" role="tab" data-toggle="tab">Track by Number</a></li>
                        <li class="nav-item"><a class="nav-link" href="#track-by-reference" aria-controls="track-by-reference" role="tab" data-toggle="tab">Track by Reference</a></li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane active" id="track-by-number">
                            <h3>Air Freight Tracking</h3>
                            <div class="put-track-number">
                                <form action="@Url.Action("Result", "Tracking")">
                                    <input type="text" class="form-control track-id" name="trackid" placeholder="Track ID" />
                                    <button type="submit" class="btn btn-track">Track</button>
                                </form>
                            </div>
                            <div class="track-bottom-link"><a href="#">Need Help?</a> <span>|</span> <a href="#">Your Order list</a></div>
                        </div>
                        <div role="tabpanel" class="tab-pane" id="track-by-reference">
                            <div class="put-reference-number">
                                <form action="@Url.Action("Index", "Tracking")">
                                    <!-- ... حقول البحث بالمرجع -->
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right sidebar start -->
            <div class="col-12 col-lg-3">
                <div class="right-block left-menu menu-with-title mt40">
                    <h4 class="title-with-bg">Select Your Freight</h4>
                    <ul>
                        <li class="active"><a href="#" title="Air Freight Tracking">Air Freight Tracking</a></li>
                        <li><a href="#" title="Ocean Freight Tracking">Ocean Freight Tracking</a></li>
                        <li><a href="#" title="Road & Rail Freight Tracking">Road & Rail Freight Tracking</a></li>
                    </ul>
                </div>
            </div>
            <!-- Right sidebar end -->
        </div>
    </div>
</div>
<!-- Tracking end -->

<!-- Send free quote start -->
<div class="wshipping-content-block get-quote">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-8"><h4>We Are Always In Here, <span>Need any Help?</span></h4></div>
            <div class="col-12 col-lg-4 text-right"><a href="@Url.Action("Index", "Contact")" title="" class="wshipping-button">Contact With Us</a></div>
        </div>
    </div>
</div>
<!-- Send free quote end -->

<!-- Our Services Start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="section-title wow fadeInUp">
                    <h2>Our Services</h2>
                    <p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- ... تكرار الخدمات -->
        </div>
    </div>
</div>
<!-- Our Services end -->