@model UI.Models.TrackingViewModel
@{
    ViewData["Title"] = "Track Shipment";
    Layout = "_Layout";
}

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Track Shipment</h1>
                <a href="/" title="Home">Home</a> / Track Shipment
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->

<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="section-title wow fadeInUp">
                    <h2>Track a Shipment</h2>
                    <p>Enter your tracking number below to get instant freight tracking information.</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="tracking-block">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" href="#track-by-number" aria-controls="track-by-number" role="tab" data-toggle="tab">Track by Number</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane active" id="track-by-number">
                            <h3>Track Your Shipment</h3>
                            <div class="put-track-number">
                                <form asp-action="Result" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="text" class="form-control track-id" name="trackingNumber" placeholder="Enter Tracking Number" />
                                    <button type="submit" class="btn btn-track">Track</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Focus on the tracking input when page loads
            $('.track-id').focus();
        });
    </script>
}