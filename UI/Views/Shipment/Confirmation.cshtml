@model Guid
@{
    ViewData["Title"] = "Shipment Confirmation";
    Layout = "_Layout";
}

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Shipment Confirmation</h1>
                <a asp-controller="Home" asp-action="Index" title="Home">Home</a> / Confirmation
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->
<!-- Confirmation Start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-8 offset-lg-2 text-center">
                <div class="error-section">
                    <i class="fas fa-check-circle fa-5x text-success"></i>
                    <h2 class="mt-4">Shipment Created Successfully!</h2>
                    <p class="lead">Your shipment has been created and is being processed.</p>

                    <div class="card mt-4">
                        <div class="card-body">
                            <h5>Shipment ID</h5>
                            <p class="text-primary font-weight-bold">@Model</p>
                            <p class="text-muted small">Please save this ID for future reference.</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="Details" asp-route-id="@Model" class="wshipping-button">
                            <i class="fa fa-eye"></i> View Shipment Details
                        </a>
                        <a asp-action="History" class="wshipping-button">
                            <i class="fa fa-list"></i> View All Shipments
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="wshipping-button">
                            <i class="fa fa-home"></i> Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Confirmation End -->