@using BL.Common
@using BL.DTOs.Views
@model PagedResult<ShipmentDetailsDto>
@{
    ViewData["Title"] = "Shipment History";
    Layout = "_Layout";
}

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>Shipment History</h1>
                <a asp-controller="Home" asp-action="Index" title="Home">Home</a> / Shipment History
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    We freight to all over the world
                    The best logistic company, <span>FAST</span> and <span>SAFELY!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->
<!-- Shipment History start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-9">
                <div class="order-list">
                    <h3>Your Shipment History</h3>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    @if (Model != null && Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Sender</th>
                                        <th>Receiver</th>
                                        <th>Shipping Date</th>
                                        <th>Weight</th>
                                        <th>Status</th>
                                        <th style="min-width: 100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td><strong>@item.TrackingNumber</strong></td>
                                            <td>@item.SenderName</td>
                                            <td>@item.ReceiverName</td>
                                            <td>@item.ShippingDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.Weight.ToString("F2") kg</td>
                                            <td>
                                                @{
                                                    var statusText = item.Status switch
                                                    {
                                                        enShipmentStatus.Created       => "Created",
                                                        enShipmentStatus.Approved      => "Approved",
                                                        enShipmentStatus.ReadyForShip  => "Ready for Ship",
                                                        enShipmentStatus.Shipped       => "Shipped",
                                                        enShipmentStatus.Delivered     => "Delivered",
                                                        enShipmentStatus.Returned      => "Returned",
                                                        _ => "Unknown"
                                                    };
                                                    
                                                    var statusStyle = item.Status switch
                                                    {
                                                        enShipmentStatus.Created       => "background-color: #d1ecf1; color: #0c5460;",
                                                        enShipmentStatus.Approved      => "background-color: #fff3cd; color: #856404;",
                                                        enShipmentStatus.ReadyForShip  => "background-color: #cce5ff; color: #004085;",
                                                        enShipmentStatus.Shipped       => "background-color: #ffe5b4; color: #804d00;",
                                                        enShipmentStatus.Delivered     => "background-color: #d4edda; color: #155724;",
                                                        enShipmentStatus.Returned      => "background-color: #f8d7da; color: #721c24;",  // لون أحمر فاتح للإرجاع
                                                        _ => "background-color: #f8f9fa; color: #212529;"
                                                    };
                                                }
                                                <span style="display: inline-block; min-width: 80px; padding: 0.35em 0.65em; font-size: 0.75rem; font-weight: 600; text-align: center; border-radius: 0.25rem; @statusStyle">
                                                    @statusText
                                                </span>
                                            </td>
                                            <td style="white-space: nowrap;">
                                                <a asp-action="Update" asp-route-id="@item.ShipmentId" title="Edit" style="color: #ffc107; font-size: 1.1rem; margin-right: 8px; text-decoration: none;">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.ShipmentId" title="View Details" style="color: #17a2b8; font-size: 1.1rem; text-decoration: none;">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- ✅ Pagination هنا (بعد الجدول مباشرة) -->
                        @if (Model.TotalCount > 0)
                        {
                            <nav aria-label="Shipment pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                        <a class="page-link" asp-action="History" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
                                    </li>
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link" asp-action="History" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link" asp-action="History" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        }

                        <!-- Buttons -->
                        <div class="text-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="wshipping-button">
                                <i class="fa fa-home"></i> Back to Dashboard
                            </a>
                            <a asp-action="Create" class="wshipping-button">
                                <i class="fa fa-plus"></i> Create New Shipment
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box fa-4x text-muted mb-3"></i>
                            <h4>No Shipments Found</h4>
                            <p>You haven't created any shipments yet.</p>
                            <div class="mt-3">
                                <a asp-action="Upsert" class="wshipping-button">Create Your First Shipment</a>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Home" asp-action="Index" class="wshipping-button">
                                    <i class="fa fa-home"></i> Back to Dashboard
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- الشريط الجانبي -->
            <div class="col-12 col-lg-3">
                <div class="right-block left-menu menu-with-title mt60 mb15">
                    <h4 class="title-with-bg">Quick Actions</h4>
                    <ul>
                        <li class="active">
                            <a asp-action="Create">
                                <i class="fa fa-plus"></i> New Shipment
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Tracking" asp-action="Index">
                                <i class="fa fa-search"></i> Track Shipment
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fa fa-dashboard"></i> Dashboard
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="right-block">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fas fa-truck fa-3x text-primary mb-2"></i>
                            <h5>Need Help?</h5>
                            <p class="small">Contact our support team for assistance</p>
                            <a asp-controller="Contact" asp-action="Index" class="wshipping-button btn-sm">Contact Us</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- الشريط الجانبي end -->
        </div>
    </div>
</div>
<!-- Shipment History end -->
<!-- Our Services Start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="section-title wow fadeInUp">
                    <h2>Our Services</h2>
                    <p>We offer a wide range of shipping services to meet your needs.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-lg-4">
                <div class="single-service-item wow fadeInUp">
                    <div class="service-item-bg service-bg-1"></div>
                    <div class="service-content">
                        <h3>Ocean Freight Shipping</h3>
                        <p>Reliable ocean freight services for international shipping.</p>
                        <a href="#" title="" class="readmore-btn">Read more <i class="fa fa-angle-right"></i></a>
                        <div class="location_map"><i class="fa fa-plus"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="single-service-item wow fadeInUp">
                    <div class="service-item-bg service-bg-2"></div>
                    <div class="service-content">
                        <h3>Air Freight Shipping</h3>
                        <p>Fast and secure air freight for time-sensitive shipments.</p>
                        <a href="#" title="" class="readmore-btn">Read more <i class="fa fa-angle-right"></i></a>
                        <div class="location_map"><i class="fa fa-plus"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="single-service-item wow fadeInUp">
                    <div class="service-item-bg service-bg-3"></div>
                    <div class="service-content">
                        <h3>Car Shipping</h3>
                        <p>Safe and affordable car shipping services nationwide.</p>
                        <a href="#" title="" class="readmore-btn">Read more <i class="fa fa-angle-right"></i></a>
                        <div class="location_map"><i class="fa fa-plus"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Our Services end -->
<!-- Send free quote start -->
<div class="wshipping-content-block get-quote">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-8">
                <h4>We Are Always In Here, <span>Need any Help?</span></h4>
            </div>
            <div class="col-12 col-lg-4 text-right">
                <a asp-controller="Contact" asp-action="Index" title="" class="wshipping-button">Contact With Us</a>
            </div>
        </div>
    </div>
</div>
<!-- Send free quote end -->