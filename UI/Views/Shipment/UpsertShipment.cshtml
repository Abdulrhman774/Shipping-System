<!-- ─── Wizard Scripts ──────────────────────────────────────────────── -->
@section Scripts {
<script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
(function () {
    'use strict';

    var totalSteps = 6;
    var currentStep = 1;

    function getStep(n) { return document.getElementById('step-' + n); }
    function getProgressItem(n) {
        return document.querySelector('#progressbar li[data-step="' + n + '"]');
    }

    function showStep(n) {
        for (var i = 1; i <= totalSteps; i++) {
            var s = getStep(i);
            var p = getProgressItem(i);
            if (s) s.classList.toggle('active', i === n);
            if (p)  p.classList.toggle('active', i <= n);
        }
        currentStep = n;

        var summary = document.querySelector('.wizard-server-errors');
        if (summary) summary.style.display = 'none';

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setButtonLoading(btn, loading) {
        if (loading) {
            btn.dataset.originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Please wait…';
            btn.disabled = true;
        } else {
            btn.innerHTML = btn.dataset.originalHtml || btn.innerHTML;
            btn.disabled = false;
        }
    }

    function validateStep(stepNum) {
        var step = getStep(stepNum);
        if (!step) return true;

        var valid = true;
        var requiredFields = step.querySelectorAll('.wizard-required');

        requiredFields.forEach(function (field) {
            var errorSpan = field.parentElement.querySelector('.wizard-field-error');

            field.classList.remove('wizard-invalid');
            if (errorSpan) errorSpan.textContent = '';

            var isEmpty = field.tagName === 'SELECT'
                ? !field.value
                : !field.value.trim();

            if (isEmpty) {
                field.classList.add('wizard-invalid');
                if (errorSpan) errorSpan.textContent = 'This field is required.';
                valid = false;
                return;
            }

            if (field.classList.contains('wizard-email')) {
        var emailRx = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRx.test(field.value.trim())) {
                    field.classList.add('wizard-invalid');
                    if (errorSpan) errorSpan.textContent = 'Please enter a valid email address.';
                    valid = false;
                }
            }

            if (field.classList.contains('wizard-number')) {
                var num = parseFloat(field.value);
                if (isNaN(num) || num <= 0) {
                    field.classList.add('wizard-invalid');
                    if (errorSpan) errorSpan.textContent = 'Please enter a value greater than zero.';
                    valid = false;
                }
            }
        });

        if (stepNum === 4) {
            var shipDate = document.getElementById('shipping-date');
            var delDate  = document.getElementById('delivery-date');
            var shipErr  = shipDate ? shipDate.parentElement.querySelector('.wizard-field-error') : null;
            var delErr   = delDate  ? delDate.parentElement.querySelector('.wizard-field-error')  : null;

            if (shipDate && shipDate.value) {
                var today = new Date(); today.setHours(0,0,0,0);
                var sd    = new Date(shipDate.value);
                if (sd < today) {
                    shipDate.classList.add('wizard-invalid');
                    if (shipErr) shipErr.textContent = 'Shipping date cannot be in the past.';
                    valid = false;
                }
            }

            if (delDate && delDate.value && shipDate && shipDate.value) {
                var sd2 = new Date(shipDate.value);
                var dd  = new Date(delDate.value);
                if (dd <= sd2) {
                    delDate.classList.add('wizard-invalid');
                    if (delErr) delErr.textContent = 'Delivery date must be after shipping date.';
                    valid = false;
                }
            }
        }

        if (!valid) {
            var firstInvalid = step.querySelector('.wizard-invalid');
            if (firstInvalid) firstInvalid.focus();
        }

        return valid;
    }

    function populateReview() {
        var sName    = document.getElementById('Sender_SenderName');
        var sAddress = document.getElementById('Sender_Address');
        var sCity    = document.getElementById('sender-city');
        var sEmail   = document.getElementById('Sender_Email');
        var sPhone   = document.getElementById('Sender_Phone');

        var sCityText = sCity && sCity.selectedIndex > 0
            ? sCity.options[sCity.selectedIndex].text : '–';

        document.getElementById('review-sender').innerHTML =
            '<strong>' + val(sName)    + '</strong><br>' +
            val(sAddress) + '<br>' + sCityText + '<br>' +
            val(sEmail)   + '<br>' + val(sPhone);

        var rName    = document.getElementById('Receiver_ReceiverName');
        var rAddress = document.getElementById('Receiver_Address');
        var rCity    = document.getElementById('receiver-city');
        var rEmail   = document.getElementById('Receiver_Email');
        var rPhone   = document.getElementById('Receiver_Phone');

        var rCityText = rCity && rCity.selectedIndex > 0
            ? rCity.options[rCity.selectedIndex].text : '–';

        document.getElementById('review-receiver').innerHTML =
            '<strong>' + val(rName)    + '</strong><br>' +
            val(rAddress) + '<br>' + rCityText + '<br>' +
            val(rEmail)   + '<br>' + val(rPhone);

        var weight = document.getElementById('Shipment_Weight');
        var length = document.getElementById('Shipment_Length');
        var width  = document.getElementById('Shipment_Width');
        var height = document.getElementById('Shipment_Height');
        var pkgVal = document.getElementById('Shipment_PackageValue');

        document.getElementById('review-weight').textContent = val(weight) || '0';
        document.getElementById('review-dims').textContent =
            (val(length)||'0') + ' × ' + (val(width)||'0') + ' × ' + (val(height)||'0') + ' cm';
        document.getElementById('review-value').textContent = val(pkgVal) || '0.00';

        var shipType = document.getElementById('shipping-type-select');
        var shipDate = document.getElementById('shipping-date');
        var delDate  = document.getElementById('delivery-date');

        var shipTypeText = shipType && shipType.selectedIndex > 0
            ? shipType.options[shipType.selectedIndex].text : '–';

        document.getElementById('review-shiptype').textContent = shipTypeText;
        document.getElementById('review-dates').textContent =
            'Ship: ' + formatDate(val(shipDate)) +
            (val(delDate) ? ' → Deliver: ' + formatDate(val(delDate)) : '');

        var payment     = document.getElementById('payment-method-select');
        var paymentText = payment && payment.selectedIndex > 0
            ? payment.options[payment.selectedIndex].text : 'Not selected';

        document.getElementById('review-payment').textContent = paymentText;
    }

    function val(el) { return el ? el.value.trim() : ''; }

    function formatDate(dateStr) {
        if (!dateStr) return '–';
        var d = new Date(dateStr);
        if (isNaN(d)) return dateStr;
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    document.querySelectorAll('.btn-next').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var self     = this;
            var nextStep = parseInt(self.dataset.next, 10);

            setButtonLoading(self, true);

            setTimeout(function () {
                var ok = validateStep(currentStep);
                setButtonLoading(self, false);

                if (!ok) return;

                if (nextStep === 6) populateReview();
                showStep(nextStep);
            }, 60);
        });
    });

    document.querySelectorAll('.btn-prev').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showStep(parseInt(this.dataset.prev, 10));
        });
    });

    document.querySelectorAll('.btn-edit-step').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showStep(parseInt(this.dataset.goto, 10));
        });
    });

    var submitBtn = document.getElementById('btn-submit-wizard');
    var wizardForm = document.getElementById('shipment-wizard-form');

    submitBtn.addEventListener('click', function (e) {
        if (!validateStep(6)) {
            e.preventDefault();
            return;
        }
    });

    wizardForm.addEventListener('submit', function () {
        setButtonLoading(submitBtn, true);
        submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> @(isEdit ? "Updating..." : "Creating...")';
    });

    document.querySelectorAll('.wizard-required').forEach(function (field) {
        field.addEventListener('input', function () {
            if (this.value.trim()) {
                this.classList.remove('wizard-invalid');
                var err = this.parentElement.querySelector('.wizard-field-error');
                if (err) err.textContent = '';
            }
        });
        field.addEventListener('change', function () {
            if (this.value) {
                this.classList.remove('wizard-invalid');
                var err = this.parentElement.querySelector('.wizard-field-error');
                if (err) err.textContent = '';
            }
        });
    });

    showStep(1);
})();
</script>
}

@{
    var errors = new List<string>();
    var tempDataErrors = TempData["ValidationErrors"];
    if (tempDataErrors is List<string> list)
    {
        errors = list;
    }
    else if (tempDataErrors is string[] array)
    {
        errors = array.ToList();
    }
}
@if (errors.Any())
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
